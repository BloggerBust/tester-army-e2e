{
  "name": "@e2e-dev/moli",
  "version": "0.0.1",
  "description": "Moli browsers for e2e: start a local CDP browser for each web worker and stop it with the run",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "ai-testing",
    "moli",
    "headless-browser",
    "browser-automation",
    "cdp"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "ldm0 <ldm2993593805@163.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e2e-inc/e2e.git",
    "directory": "packages/moli"
  },
  "bugs": {
    "url": "https://github.com/e2e-inc/e2e/issues"
  },
  "homepage": "https://github.com/e2e-inc/e2e/tree/main/packages/moli#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "peerDependencies": {
    "@e2e-dev/web": ">=0.11.0 <1",
    "e2e": ">=0.15.0 <1"
  },
  "devDependencies": {
    "@e2e-dev/web": "workspace:*",
    "@types/node": "26.6.6",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
