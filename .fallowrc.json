{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "apps/testbed/e2e.config.ts",
    "apps/testbed/e2e.*.config.ts",
    "apps/testbed/tests*/**/*.ts",
    "apps/testbed/dogfood/server.mjs",
    "apps/testbed/app/bug-garden.mjs",
    "apps/web-benchmark/e2e.config.ts",
    "apps/web-benchmark/e2e.*.config.ts",
    "apps/web-benchmark/tests*/**/*.ts",
    "apps/web-benchmark/app/src/app/**/*.{ts,tsx}",
    "apps/mobile-benchmark/e2e.config.ts",
    "apps/mobile-benchmark/e2e.*.config.ts",
    "apps/mobile-benchmark/tests*/**/*.ts",
    "apps/mobile-benchmark/index.ts",
    "apps/desktop-testbed/e2e.config.ts",
    "apps/desktop-testbed/e2e.*.config.ts",
    "apps/desktop-testbed/tests*/**/*.ts",
    "packages/e2e/tests/types/sdk-types.ts",
    "packages/web/tests/types/connection.ts",
    "packages/web/tests/types/init-scripts.ts",
    "packages/web/tests/types/keyboard.ts",
    "packages/web/tests/types/media.ts",
    "packages/web/tests/types/network.ts",
    "packages/web/tests/types/routes.ts",
    "packages/web/tests/types/webmcp.ts",
    "packages/web/tests/types/clear-cookies.ts",
    "packages/web/tests/types/downloads.ts",
    "packages/web/tests/types/app.ts",
    "packages/web/tests/types/engine.ts",
    "packages/mobile/tests/types/options.ts",
    "packages/mobile/tests/types/engine.ts",
    "packages/desktop/tests/types/engine.ts",
    "packages/browser-run/tests/types/options.ts",
    "packages/moli/tests/types/options.ts",
    "packages/decision/tests/types/options.ts",
    "packages/acp/tests/fixtures/scripted-agent.ts",
    "packages/desktop/tests/helpers/fake-agent-desktop.mjs",
    "packages/acp/tests/live/*.ts",
    "packages/e2e/tests/live/*.ts",
    "packages/e2e/src/config/register.ts",
    "scripts/microbench/child.mjs"
  ],
  "ignorePatterns": [
    "docs/**",
    "examples/**",
    "**/next-env.d.ts",
    "**/.e2e/**",
    "apps/testbed/app/playwright/assets/**",
    "packages/e2e/tests/tmp-projects/**"
  ],
  "ignoreDependencies": [
    "e2e",
    "@e2e-dev/web",
    "@openrouter/ai-sdk-provider",
    "@expo/fingerprint",
    "@expo/repack-app",
    "@oxc-project/runtime"
  ],
  "ignoreBinaries": ["eas", "vhs", "valgrind"],
  "ignoreExports": [
    {
      "file": "packages/core/src/types.ts",
      "exports": ["StandardSchemaV1"]
    }
  ],
  "rules": {
    "unused-class-member": "warn",
    "dev-dependencies-in-production": "warn"
  },
  "ignoreUnresolvedImports": [
    "**/dist/**"
  ]
}
